{
  "name": "fasrep",
  "version": "3.4.0",
  "description": "FASREP PWA App - SOFACOMPANY",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/assert-build.js",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && node scripts/prepare-pages-deploy.js && wrangler pages deploy dist --project-name fasrep --branch main",
    "deploy:worker": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.1.0",
    "wrangler": "^4.151.2"
  }
}
